# =============================================================================
# Lapak Jambi Web — Environment Variables Example
# =============================================================================
# Salin file ini menjadi .env.local dan sesuaikan nilainya.

# Server Port Development & Production
# (Menghindari bentrok dengan backend seloko-api :3000 dan seloko-web :3001)
PORT=3002
NEXT_PUBLIC_PORT=3002
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Backend Seloko API (Centralized NestJS)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_CODE=lapak-jambi-web

# ImageKit Storage CDN
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/o7kpef481o
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_JCJrpcGrOacfntN3DKGuuPN2FL4="

# Informasi Aplikasi & Branding
NEXT_PUBLIC_APP_NAME="Lapak Jambi"
NEXT_PUBLIC_APP_DESCRIPTION="Platform Layanan Publik & Pemesanan Fasilitas Aset Daerah Pemerintah Provinsi Jambi"
NEXT_PUBLIC_APP_VERSION=0.1.0
