# =============================================================================
# Lapak Jambi Web — Environment Variables
# =============================================================================
# Salin file ini menjadi .env.local dan isi nilai yang sesuai.

# Backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_CODE=lapak-jambi-web

# ImageKit (untuk menampilkan gambar dari storage API)
NEXT_PUBLIC_IMAGEKIT_URL=https://ik.imagekit.io/o7kpef481o

# App Info
NEXT_PUBLIC_APP_NAME=Lapak Jambi
NEXT_PUBLIC_APP_DESCRIPTION=Platform Layanan Publik Digital Pemerintah Provinsi Jambi
NEXT_PUBLIC_APP_VERSION=0.1.0
